# Скопируйте в .env и заполните. Без ключа приложение работает
# в keyless-режиме: детерминированный fake-LLM вместо OpenRouter.
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Ниже — значения по умолчанию, менять не обязательно.

# Деградация LLM (docs/monitoring.md): circuit breaker и дневной бюджет вызовов.
LLM_BREAKER_FAILURE_THRESHOLD=3
LLM_BREAKER_RESET_SECONDS=30
LLM_DAILY_BUDGET_CALLS=1000
LLM_SIMULATE_DOWN=false

# Политика решений (docs/architecture.md): пороги эскалации и категории,
# которые никогда не отвечают автоматически (список через запятую).
CONFIDENCE_THRESHOLD=0.55
RETRIEVAL_THRESHOLD=0.15
NEVER_AUTO_TOPICS=payment
